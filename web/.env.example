# Copy this file to .env.local (ignored by git) and fill in the values from your Supabase project's
# Connect dialog or Project Settings > API Keys. Restart `npm run dev` after changing it.
# Use the publishable (or legacy anon) key only. Never put the secret or service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
